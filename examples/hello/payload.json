{
  "id": "hello-civswitch",
  "name": "Hello CivHomebrew",
  "author": "XITRIX",
  "release": "0.2.0",
  "description": "CivHomebrew SDK example: input, shared native UI and cooperative return to Launcher.",
  "api": 1,
  "scripts": [
    "app/vendor/native-ui-runtime.js",
    "app.js"
  ],
  "icon": "icon.png",
  "extensions": {
    "nativeUi": {
      "api": 1,
      "library": "civapps-native-ui",
      "version": "1.3.6",
      "minVersion": "1.3.5"
    },
    "execution": {
      "schema": 1,
      "scripts": "ordered"
    }
  }
}
